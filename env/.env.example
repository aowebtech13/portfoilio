# Frontend env example
# -------------------
# The frontend is plain HTML/JS, so "env variables" are defined in
# env/env.js (defaults) and overridden in env/env.dev.js or
# env/env.prod.js. Use this file as documentation/reference.

# Laravel API base URL (no trailing slash)
API_BASE_URL=http://localhost:8000/api

# Frontend origin (for absolute links)
FRONTEND_URL=http://localhost:5500

# Backend origin (for asset URLs, admin links, etc.)
BACKEND_URL=http://localhost:8000

# Request timeout in ms
REQUEST_TIMEOUT_MS=15000

# Toggle API debug logs in the browser console
DEBUG=true

# Optional bearer token for protected endpoints
AUTH_TOKEN=